# This is an example .env.local file.Please replace the placeholder values with your actual credentials.
#Configure your Cloudflare account and API token
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_workers_ai_token
CF_GATEWAY_ID=your_gateway_name
CF_AIG_TOKEN=your_gateway_token
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
# Configure your Supabase URL and Service Role Key
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key